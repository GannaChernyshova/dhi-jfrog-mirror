# cp .env.example .env && chmod 600 .env     (.env is git-ignored)

# ── Source: DHI repository mirrored into your Docker Hub organization ─────────
DOCKER_ORG=your-org
SRC_IMAGE=dhi-node
# Tags to mirror, space separated. Keep equal to the allow-list in regsync.yaml.
TAGS="24 24-dev"

# Organization access token with Image Pull on the mirrored dhi-* repositories.
# Username is the organization name.
DOCKER_USERNAME=your-org
DOCKER_TOKEN=

# Docker Scout (make use, CI scan) needs a personal access token (Repo Read-only)
# of an organization member. Scout does not accept organization access tokens.
SCOUT_USERNAME=
SCOUT_TOKEN=

# ── Destination: JFrog Artifactory ────────────────────────────────────────────
JFROG_HOST=acme.jfrog.io

# Local repository the sync writes to (required).
JFROG_REPO=dhi-local
# Virtual repository developers and CI pull from, and local repository for the
# images they build. Optional: leave empty to use JFROG_REPO for everything.
JFROG_VIRTUAL=docker
JFROG_APPS_REPO=apps-local
# Image name in Artifactory (defaults to SRC_IMAGE):  <host>/<repo>/<DEST_IMAGE>:<tag>
DEST_IMAGE=dhi-node

# Account with Read, Deploy/Cache and Delete/Overwrite on JFROG_REPO.
# Username and token as shown by "Set Me Up" (the token, not the base64 auth value).
JFROG_USER=
JFROG_TOKEN=

# Base tags used by make app (examples/app). Default: 24 and 24-dev.
# NODE_TAG=24
# NODE_DEV_TAG=24-dev

# Platform for make use / make app. Default: this machine's architecture.
# PLATFORM=linux/amd64
