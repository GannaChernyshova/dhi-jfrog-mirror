# cp .env.example .env && chmod 600 .env     (.env is git-ignored)

# ── Source: DHI repository mirrored into your Docker Hub organization ─────────

# Docker Hub organization name: the part before the slash in docker.io/<org>/dhi-node.
# Find it at hub.docker.com, in the organization switcher at the top left.
DOCKER_ORG=your-org

# DHI repository name in that organization. Hub → <org> → Repositories, the dhi-* entries.
SRC_IMAGE=dhi-node

# Tags to mirror, space separated. Open the repository on Hub → Tags to see them.
# Keep equal to the allow-list in regsync.yaml.
TAGS="24 24-dev"

# Used by the sync to read the image from Docker Hub and the attestations from
# registry.scout.docker.com.
#   DOCKER_USERNAME: the organization name (same value as DOCKER_ORG), not your personal Docker ID.
#   DOCKER_TOKEN:    an organization access token (OAT). Create it at
#                    Docker Hub → <org> → Settings → Access tokens → Generate token.
#                    Repository access: the mirrored dhi-* repositories. Scope: Image Pull.
#                    The token is shown once; copy it now.
DOCKER_USERNAME=your-org
DOCKER_TOKEN=

# Used only by Docker Scout (make use, CI scan). Scout does not accept organization
# access tokens, so this is a personal token, not the one above.
#   SCOUT_USERNAME: your personal Docker ID (the username you log in to Docker Hub with).
#                   The account must be a member of the organization.
#   SCOUT_TOKEN:    a personal access token (PAT). Create it at
#                   Docker Hub → your avatar → Account settings → Personal access tokens
#                   → Generate new token. Permission: Repo Read-only. Copy it when shown.
SCOUT_USERNAME=
SCOUT_TOKEN=

# ── Destination: JFrog Artifactory ────────────────────────────────────────────

# Your Artifactory hostname, without https://. It is the host in your JFrog URL:
# https://acme.jfrog.io/ui → acme.jfrog.io
JFROG_HOST=acme.jfrog.io

# Local repository the sync writes to (required). It must be a Docker repository of
# type "local", not remote. Artifactory → Administration → Repositories → Repositories.
JFROG_REPO=dhi-local
# Virtual repository developers and CI pull from. Optional: leave empty to pull
# from JFROG_REPO directly. Same place: the Docker repositories of type "virtual".
JFROG_VIRTUAL=docker
# Image name in Artifactory (defaults to SRC_IMAGE):  <host>/<repo>/<DEST_IMAGE>:<tag>
DEST_IMAGE=dhi-node

# Account with Read, Deploy/Cache and Delete/Overwrite on JFROG_REPO.
#   JFROG_USER:  the username shown in Artifactory → Set Me Up for the repository
#                (often your email address). For a service account, its username.
#   JFROG_TOKEN: Artifactory → the repository → Set Me Up → Generate Token, or
#                your avatar → Edit Profile → Identity Tokens. Use the token itself,
#                not the base64 "auth" value shown for config.json.
JFROG_USER=
JFROG_TOKEN=

# Base tags used by make app (examples/app). Default: 24 and 24-dev.
# NODE_TAG=24
# NODE_DEV_TAG=24-dev

# Platform for make use / make app. Default: this machine's architecture.
# PLATFORM=linux/amd64
